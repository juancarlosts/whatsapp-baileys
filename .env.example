# Claves: nombre:clave:alcance separadas por coma (obligatorio)
#   alcance "*"                  -> administrador (todas las sesiones, crear y eliminar)
#   alcance "sistema|gualasoft"  -> solo esas sesiones ("cliente-*" admite comodín final)
# Generar una clave: openssl rand -hex 24
API_KEYS=saas:cambiar:*,persondata:cambiar:sistema,artehierro:cambiar:sistema,n8n:cambiar:sistema|gualasoft

# Máximo de sesiones (números). Al subirlo, subir también mem_limit en docker-compose.yml
MAX_SESSIONS=10

# Cola de envío (valores por defecto)
SEND_INTERVAL_MS=4000
QUEUE_MAX=200
QUEUE_MAX_MB=20
PER_RECIPIENT_PER_MIN=5

# Límites contra el bloqueo (valores por defecto)
DEFAULT_DAILY_LIMIT=500
DEFAULT_NEW_CHATS_LIMIT=100
# Mensajes/día la primera semana de un número; se duplica cada semana durante 4
WARMUP_BASE=30
TIMEZONE=America/Guayaquil

# Log de Baileys: warn | error | silent
LOG_LEVEL=warn

# Opcional: recibe un aviso si WhatsApp cierra una sesión
ALERT_WEBHOOK_URL=

# Opcional: se envía como header X-Webhook-Token en todos los webhooks
WEBHOOK_TOKEN=
