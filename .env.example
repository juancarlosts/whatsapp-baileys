# Claves por sistema: nombre:clave separados por coma (obligatorio)
# Generar una clave: openssl rand -hex 24
API_KEYS=saas:cambiar,persondata:cambiar,artehierro:cambiar,n8n:cambiar

# Cola de envío (valores por defecto)
SEND_INTERVAL_MS=4000
QUEUE_MAX=200
QUEUE_MAX_MB=20
PER_RECIPIENT_PER_MIN=5

# Log de Baileys: warn | error | silent
LOG_LEVEL=warn

# Opcional: webhook (p. ej. n8n) que recibe un aviso si WhatsApp cierra la sesión
ALERT_WEBHOOK_URL=
